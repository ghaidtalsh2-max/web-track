# =============================================================================
# إعدادات بيئة منصة مسار الويب — GDGoC TU
# احفظ هذا الملف باسم .env واملأ القيم الخاصة بمشروع Supabase
# =============================================================================

# رابط مشروع Supabase (من لوحة تحكم Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# المفتاح العام الآمن للمتصفح (anon public key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# المفتاح السري الإداري للخادم وعمليات الترحيل والاستيراد فقط (service_role secret)
# ⚠️ لا تضع هذا المفتاح في المتصفح أو أي مستودع عام إطلاقاً
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
